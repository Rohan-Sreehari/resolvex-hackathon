# PostgreSQL connection. Example for a local database named resolvex.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/resolvex?schema=public
# Use the same URL for a local database. For a managed/pooler setup, set the direct non-pooled URL here.
DIRECT_URL=postgresql://postgres:your_password@localhost:5432/resolvex?schema=public

# Generate a private random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=8h

PORT=3000
# Local private upload folder. Vercel uses temporary /tmp storage instead.
UPLOAD_DIR=./storage/private
MAX_FILE_BYTES=20971520
MAX_TOTAL_UPLOAD_BYTES=31457280

# Optional: enables server-side image and description analysis.
# If omitted or unavailable, reports use a clearly labelled local keyword fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Optional: create bootstrap staff accounts during `npm run db:seed`.
# Use a password of at least 12 characters. No staff accounts are seeded by default.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=ResolveX Administrator
SEED_OFFICER_EMAIL=
SEED_OFFICER_PASSWORD=
SEED_OFFICER_NAME=ResolveX Officer
SEED_DEMO_REPORTS=false
